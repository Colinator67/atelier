{
  // Configuration du Worker "atelier" : site statique + envoi des demandes
  "name": "atelier",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // garde les variables ajoutées dans le tableau de bord Cloudflare lors des déploiements
  "keep_vars": true
}
